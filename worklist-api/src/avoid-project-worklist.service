[Unit]
Description=GCGenome Avoid Service: Worklist

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=java -jar /var/lib/lims/avoid-project-worklist.jar --spring.config.location=/etc/lims/avoid-gateway.yml
ExecReload=/bin/kill -INT
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
