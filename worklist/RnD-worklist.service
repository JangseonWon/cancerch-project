[Unit]
Description=GCGenome RnD: worklist Service

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=java -jar /var/lib/lims/RnD-worklist.jar --spring.config.location=/etc/lims/RnD-worklist.yml
ExecReload=/bin/kill -INT 
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
