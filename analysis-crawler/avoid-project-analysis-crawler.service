[Unit]
Description=GCGenome Avoid Service: Analysis-crawler

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=/usr/lib/jvm/jre-17/bin/java -jar /data/lims/avoid-project-analysis-crawler.jar --spring.config.location=/etc/lims/avoid-project-analysis-crawler.yml
ExecReload=/bin/kill -INT
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
