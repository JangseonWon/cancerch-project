[Unit]
Description=GCGenome RnD Service

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=java -jar /var/lib/lims/RnD-1.0.jar --spring.config.location=/etc/lims/RnD.yml
ExecReload=/bin/kill -INT
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
