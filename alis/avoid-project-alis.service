[Unit]
Description=GCGenome Avoid Service: ALIS

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=/usr/lib/jvm/jre-17/bin/java -jar /data/lims/avoid-project-alis.jar --spring.config.location=/etc/lims/avoid-project-alis.yml
ExecReload=/bin/kill -INT 
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
